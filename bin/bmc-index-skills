#!/usr/bin/env python3
import sys
import os
import json
import subprocess
import shutil
import tempfile

# Resolve paths relative to the script location (one level up from bin/)
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
BMC_STUFF_DIR = os.path.dirname(SCRIPT_DIR)

def parse_yaml_frontmatter(file_path):
    name = None
    description = None
    try:
        with open(file_path, "r", encoding="utf-8") as f:
            content = f.read()
        if content.startswith("---"):
            end_fm = content.find("---", 3)
            if end_fm != -1:
                fm_text = content[3:end_fm]
                lines = fm_text.splitlines()
                
                fm_dict = {}
                current_key = None
                multiline_accumulator = []
                is_multiline = False
                
                for line in lines:
                    stripped = line.strip()
                    if not stripped:
                        continue
                    
                    if ":" in line and not is_multiline:
                        parts = line.split(":", 1)
                        key = parts[0].strip().lower()
                        val = parts[1].strip()
                        
                        if val in (">", "|"):
                            current_key = key
                            is_multiline = True
                            multiline_accumulator = []
                        else:
                            fm_dict[key] = val.strip('"').strip("'")
                            current_key = None
                            is_multiline = False
                    elif is_multiline:
                        if ":" in line and not line.startswith(" "):
                            fm_dict[current_key] = " ".join(multiline_accumulator).strip().strip('"').strip("'")
                            parts = line.split(":", 1)
                            key = parts[0].strip().lower()
                            val = parts[1].strip()
                            if val in (">", "|"):
                                current_key = key
                                is_multiline = True
                                multiline_accumulator = []
                            else:
                                fm_dict[key] = val.strip('"').strip("'")
                                current_key = None
                                is_multiline = False
                        else:
                            multiline_accumulator.append(stripped)
                            
                if is_multiline and current_key:
                    fm_dict[current_key] = " ".join(multiline_accumulator).strip().strip('"').strip("'")
                    
                name = fm_dict.get("name")
                description = fm_dict.get("description")
    except Exception:
        pass
    return name, description

def index_skills(silent=False):
    catalog_path = os.path.join(BMC_STUFF_DIR, "knowledge", "skills-catalog.json")
    if not os.path.exists(catalog_path):
        print(f"Error: Catalog file not found at {catalog_path}")
        sys.exit(1)
        
    with open(catalog_path, "r", encoding="utf-8") as f:
        catalog = json.load(f)
        
    cache_dir = os.path.join(BMC_STUFF_DIR, "skills-cache")
    # Clean previous cache to ensure freshness
    if os.path.exists(cache_dir):
        shutil.rmtree(cache_dir)
    os.makedirs(cache_dir, exist_ok=True)
    
    skills_index = []
    
    for repo in catalog.get("repositories", []):
        name = repo.get("name")
        url = repo.get("url")
        selections = repo.get("selection", [])
        
        if not silent:
            print(f"Cloning {name} from {url}...")
            
        with tempfile.TemporaryDirectory() as temp_dir:
            try:
                subprocess.run(
                    ["git", "clone", "--depth", "1", url, temp_dir],
                    check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL
                )
            except Exception as e:
                print(f"Error cloning repository {name}: {e}")
                continue
                
            for selection in selections:
                sel_path = os.path.join(temp_dir, selection)
                if not os.path.exists(sel_path):
                    continue
                
                for root, dirs, files in os.walk(sel_path):
                    if "SKILL.md" in files:
                        skill_file = os.path.join(root, "SKILL.md")
                        skill_name, skill_desc = parse_yaml_frontmatter(skill_file)
                        if not skill_name:
                            skill_name = os.path.basename(root)
                            
                        dest_skill_dir = os.path.join(cache_dir, name, skill_name)
                        os.makedirs(dest_skill_dir, exist_ok=True)
                        
                        for item in os.listdir(root):
                            s_item = os.path.join(root, item)
                            d_item = os.path.join(dest_skill_dir, item)
                            if os.path.isdir(s_item):
                                if item != ".git":
                                    shutil.copytree(s_item, d_item, dirs_exist_ok=True)
                            else:
                                shutil.copy2(s_item, d_item)
                                
                        skills_index.append({
                            "name": skill_name,
                            "description": skill_desc or "No description provided.",
                            "repo_name": name,
                            "repo_url": url.replace(".git", ""),
                            "local_path": os.path.join(".bmc-stuff", "skills-cache", name, skill_name, "SKILL.md")
                        })
                        
    index_dest = os.path.join(cache_dir, "skills-index.json")
    with open(index_dest, "w", encoding="utf-8") as f:
        json.dump(skills_index, f, indent=2)
        
    if not silent:
        print(f"Skills index generated successfully at {index_dest} ({len(skills_index)} skills cached).")

def main():
    silent = "--silent" in sys.argv
    try:
        index_skills(silent=silent)
    except Exception as e:
        print(f"Failed to index skills: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
