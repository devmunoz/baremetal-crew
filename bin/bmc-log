#!/usr/bin/env python3
import sys
import os
import sqlite3

# Resolve DB path relative to the script location (one level up from bin/)
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))
BMC_STUFF_DIR = os.path.dirname(SCRIPT_DIR)
DB_PATH = os.path.join(BMC_STUFF_DIR, "crew.db")

def init_db():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS transitions (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        slice_id TEXT NOT NULL,
        from_phase TEXT NOT NULL,
        to_phase TEXT NOT NULL,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        details TEXT
    );
    """)
    
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS tasks (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        slice_id TEXT NOT NULL,
        task_id TEXT NOT NULL,
        module TEXT NOT NULL,
        description TEXT NOT NULL,
        status TEXT NOT NULL,
        assigned_to TEXT NOT NULL,
        ping_pong_count INTEGER DEFAULT 0,
        updated_at DATETIME DEFAULT CURRENT_TIMESTAMP
    );
    """)
    
    cursor.execute("""
    CREATE TABLE IF NOT EXISTS events (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        slice_id TEXT NOT NULL,
        timestamp DATETIME DEFAULT CURRENT_TIMESTAMP,
        agent_role TEXT NOT NULL,
        event_type TEXT NOT NULL,
        message TEXT NOT NULL
    );
    """)
    
    conn.commit()
    conn.close()

def log_transition(slice_id, from_phase, to_phase, details):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO transitions (slice_id, from_phase, to_phase, details) VALUES (?, ?, ?, ?)",
        (slice_id, from_phase, to_phase, details)
    )
    conn.commit()
    conn.close()
    print(f"[TRANSITION] {slice_id}: {from_phase} -> {to_phase} | {details}")

def log_task(slice_id, task_id, status, ping_pong_count=0):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Check if task already exists
    cursor.execute("SELECT id FROM tasks WHERE slice_id = ? AND task_id = ?", (slice_id, task_id))
    row = cursor.fetchone()
    
    if row:
        cursor.execute(
            "UPDATE tasks SET status = ?, ping_pong_count = ?, updated_at = CURRENT_TIMESTAMP WHERE id = ?",
            (status, ping_pong_count, row[0])
        )
    else:
        # Default empty values if inserting a new task
        cursor.execute(
            "INSERT INTO tasks (slice_id, task_id, module, description, status, assigned_to, ping_pong_count) VALUES (?, ?, 'TBD', 'TBD', ?, 'TBD', ?)",
            (slice_id, task_id, status, ping_pong_count)
        )
    conn.commit()
    conn.close()
    print(f"[TASK] {slice_id} - {task_id}: {status} (Ping-Pong: {ping_pong_count})")

def log_event(slice_id, agent_role, event_type, message):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        "INSERT INTO events (slice_id, agent_role, event_type, message) VALUES (?, ?, ?, ?)",
        (slice_id, agent_role, event_type, message)
    )
    conn.commit()
    conn.close()
    print(f"[EVENT] {slice_id} | {agent_role} | {event_type} | {message}")

def get_current_phase(slice_id):
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute(
        "SELECT to_phase FROM transitions WHERE slice_id = ? ORDER BY timestamp DESC, id DESC LIMIT 1",
        (slice_id,)
    )
    row = cursor.fetchone()
    conn.close()
    return row[0] if row else "Not Started"

def is_successful_phase(phase):
    p = phase.lower()
    return any(w in p for w in ["completed", "closed"])

def cbo_sign(slice_id, custom_details=None):
    current_phase = get_current_phase(slice_id)
    p = current_phase.lower()
    
    if "phase 3" in p or "execution" in p:
        from_phase = "Phase 3: Execution"
        to_phase = "Phase 4 Completed"
        default_details = f".bmc-stuff/work/{slice_id}-DEMO.md validated by CBO"
    elif "phase 2" in p or "breakdown" in p:
        from_phase = "Phase 2: Breakdown"
        to_phase = "Phase 3: Execution"
        default_details = f".bmc-stuff/work/{slice_id}-BLUEPRINT.md signed by CBO"
    elif "phase 4" in p or is_successful_phase(current_phase):
        print(f"[CBO-SIGN] Slice {slice_id} is already in final phase: {current_phase}")
        return
    else:
        # Default: Not Started or Phase 1: Grill -> transition to Phase 2
        from_phase = "Phase 1: Grill"
        to_phase = "Phase 2: Breakdown"
        default_details = f".bmc-stuff/work/{slice_id}-SCOPE.md signed by CBO"
        
    details = custom_details if custom_details else default_details
    log_transition(slice_id, from_phase, to_phase, details)
def show_slice(slice_id):
    current_phase = get_current_phase(slice_id)
    print(f"Slice: {slice_id}")
    print(f"Current Phase: {current_phase}")
    print("-" * 50)
    
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Tasks
    cursor.execute(
        "SELECT task_id, status, ping_pong_count, updated_at FROM tasks WHERE slice_id = ? ORDER BY task_id ASC",
        (slice_id,)
    )
    tasks = cursor.fetchall()
    print("Tasks:")
    if tasks:
        print(f"{'Task ID':<12} | {'Status':<20} | {'Ping-Pong':<9} | {'Updated At'}")
        print("-" * 65)
        for t in tasks:
            print(f"{t[0]:<12} | {t[1]:<20} | {t[2]:<9} | {t[3]}")
    else:
        print("  No tasks logged yet.")
    print("-" * 50)
    
    # Recent Events
    cursor.execute(
        "SELECT timestamp, agent_role, event_type, message FROM events WHERE slice_id = ? ORDER BY timestamp DESC, id DESC LIMIT 5",
        (slice_id,)
    )
    events = cursor.fetchall()
    print("Recent Events (Last 5):")
    if events:
        for e in events:
            print(f"  [{e[0]}] {e[1]} ({e[2]}): {e[3]}")
    else:
        print("  No events logged yet.")
    conn.close()

def list_active_slices():
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    cursor.execute("""
        SELECT DISTINCT slice_id FROM transitions
        EXCEPT
        SELECT DISTINCT slice_id FROM transitions 
        WHERE to_phase IN ('Completed', 'Successfully Completed', 'Closed', 'Aborted')
    """)
    rows = cursor.fetchall()
    conn.close()
    
    active_slices = [r[0] for r in rows]
    if active_slices:
        for slice_id in active_slices:
            print(slice_id)
    else:
        print("No active slices found.")

def check_dependency(slice_id):
    current_phase = get_current_phase(slice_id)
    if is_successful_phase(current_phase):
        print(f"Dependency {slice_id} is resolved (Phase: {current_phase}).")
        sys.exit(0)
    else:
        print(f"Dependency {slice_id} is unresolved (Phase: {current_phase}).")
        sys.exit(1)

def print_usage():
    print("Usage:")
    print("  bmc-log transition <slice_id> <from_phase> <to_phase> <details>")
    print("  bmc-log cbo-sign <slice_id> [details]")
    print("  bmc-log task <slice_id> <task_id> <status> [ping_pong_count]")
    print("  bmc-log event <slice_id> <agent_role> <event_type> <message>")
    print("  bmc-log active")
    print("  bmc-log show-slice <slice_id>")
    print("  bmc-log check-dependency <slice_id>")
def main():
    if len(sys.argv) < 2:
        print_usage()
        sys.exit(1)
        
    init_db()
    action = sys.argv[1].lower()
    
    try:
        if action == "transition":
            if len(sys.argv) < 6:
                print("Error: Missing arguments for transition log.")
                print("Usage: bmc-log transition <slice_id> <from_phase> <to_phase> <details>")
                sys.exit(1)
            log_transition(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
        elif action == "cbo-sign":
            if len(sys.argv) < 3:
                print("Error: Missing slice_id.")
                print("Usage: bmc-log cbo-sign <slice_id> [details]")
                sys.exit(1)
            details = sys.argv[3] if len(sys.argv) > 3 else None
            cbo_sign(sys.argv[2], details)
            
        elif action == "task":
            if len(sys.argv) < 5:
                print("Error: Missing arguments for task log.")
                print("Usage: bmc-log task <slice_id> <task_id> <status> [ping_pong_count]")
                sys.exit(1)
            ping_pong = int(sys.argv[5]) if len(sys.argv) > 5 else 0
            log_task(sys.argv[2], sys.argv[3], sys.argv[4], ping_pong)
            
        elif action == "event":
            if len(sys.argv) < 6:
                print("Error: Missing arguments for event log.")
                print("Usage: bmc-log event <slice_id> <agent_role> <event_type> <message>")
                sys.exit(1)
            log_event(sys.argv[2], sys.argv[3], sys.argv[4], sys.argv[5])
            
        elif action == "active":
            list_active_slices()
            
        elif action == "show-slice":
            if len(sys.argv) < 3:
                print("Error: Missing slice_id.")
                print("Usage: bmc-log show-slice <slice_id>")
                sys.exit(1)
            show_slice(sys.argv[2])
            
        elif action == "check-dependency":
            if len(sys.argv) < 3:
                print("Error: Missing slice_id.")
                print("Usage: bmc-log check-dependency <slice_id>")
                sys.exit(1)
            check_dependency(sys.argv[2])
            
        else:
            print(f"Unknown action: {action}")
            print_usage()
            sys.exit(1)
    except Exception as e:
        print(f"Database error: {e}")
        sys.exit(1)

if __name__ == "__main__":
    main()
