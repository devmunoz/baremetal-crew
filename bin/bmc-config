#!/usr/bin/env python3
import sys
import os
import json
import argparse

# Resolve config path relative to the script location (one level up from bin/)
SCRIPT_DIR = os.path.dirname(os.path.realpath(__file__))
BMC_STUFF_DIR = os.path.dirname(SCRIPT_DIR)
CONFIG_PATH = os.path.join(BMC_STUFF_DIR, "config.json")

DEFAULT_CONFIG = {
    "version": "1.1.0",
    "runtime": "docker",
    "worktrees": False,
    "max_ping_pong": 3,
    "communication_mode": "ste100",
    "pr_demo_mode": "reference"
}

VALID_RUNTIMES = ["docker", "local"]
VALID_COMMS = ["ste100", "caveman"]
VALID_PR_DEMO_MODES = ["reference", "embed", "minimal"]
def load_config():
    if not os.path.exists(CONFIG_PATH):
        return DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_PATH, "r", encoding="utf-8") as f:
            data = json.load(f)
            config = DEFAULT_CONFIG.copy()
            config.update(data)
            return config
    except Exception as e:
        print(f"Error reading config at {CONFIG_PATH}: {e}")
        sys.exit(1)

def save_config(config):
    os.makedirs(os.path.dirname(CONFIG_PATH), exist_ok=True)
    try:
        with open(CONFIG_PATH, "w", encoding="utf-8") as f:
            json.dump(config, f, indent=2)
            f.write("\n")
    except Exception as e:
        print(f"Error writing config to {CONFIG_PATH}: {e}")
        sys.exit(1)

def parse_typed_value(key, value_str):
    k = key.lower()
    v = value_str.strip()

    if k in ["worktrees", "worktree"]:
        if v.lower() in ["true", "1", "yes", "y", "enable", "enabled"]:
            return "worktrees", True
        elif v.lower() in ["false", "0", "no", "n", "disable", "disabled"]:
            return "worktrees", False
        else:
            print(f"Error: Invalid boolean value '{value_str}' for key '{key}'. Use true/false.")
            sys.exit(1)

    elif k in ["max_ping_pong", "ping_pong", "pingpong"]:
        try:
            val = int(v)
            if val < 1:
                raise ValueError()
            return "max_ping_pong", val
        except ValueError:
            print(f"Error: Invalid integer value '{value_str}' for key '{key}'. Must be >= 1.")
            sys.exit(1)

    elif k == "runtime":
        if v.lower() not in VALID_RUNTIMES:
            print(f"Error: Invalid runtime '{value_str}'. Allowed: {', '.join(VALID_RUNTIMES)}.")
            sys.exit(1)
        return "runtime", v.lower()

    elif k in ["communication_mode", "communication", "comms"]:
        if v.lower() not in VALID_COMMS:
            print(f"Error: Invalid communication mode '{value_str}'. Allowed: {', '.join(VALID_COMMS)}.")
            sys.exit(1)
        return "communication_mode", v.lower()
    elif k in ["pr_demo_mode", "pr_demo", "pr_mode", "pr-demo-mode"]:
        if v.lower() not in VALID_PR_DEMO_MODES:
            print(f"Error: Invalid pr_demo_mode '{value_str}'. Allowed: {', '.join(VALID_PR_DEMO_MODES)}.")
            sys.exit(1)
        return "pr_demo_mode", v.lower()

    else:
        # Generic string setting
        return key, value_str

def cmd_show():
    config = load_config()
    print(json.dumps(config, indent=2))

def cmd_get(key):
    config = load_config()
    normalized_key = key.lower()
    # Map common aliases
    alias_map = {
        "worktree": "worktrees",
        "ping_pong": "max_ping_pong",
        "pingpong": "max_ping_pong",
        "communication": "communication_mode",
        "comms": "communication_mode",
        "pr_demo": "pr_demo_mode",
        "pr_mode": "pr_demo_mode",
        "pr-demo-mode": "pr_demo_mode"
    }
    target_key = alias_map.get(normalized_key, normalized_key)
    
    if target_key in config:
        val = config[target_key]
        if isinstance(val, bool):
            print("true" if val else "false")
        else:
            print(val)
    else:
        print(f"Error: Key '{key}' not found in configuration.")
        sys.exit(1)

def cmd_set(key, value_str):
    config = load_config()
    norm_key, parsed_value = parse_typed_value(key, value_str)
    config[norm_key] = parsed_value
    save_config(config)
    print(f"[CONFIG] Set '{norm_key}' = {parsed_value}")

def cmd_init(runtime=None, worktrees=None, max_ping_pong=None, communication_mode=None, pr_demo_mode=None):
    config = DEFAULT_CONFIG.copy()
    if os.path.exists(CONFIG_PATH):
        config = load_config()

    if runtime is not None:
        if runtime.lower() not in VALID_RUNTIMES:
            print(f"Error: Invalid runtime '{runtime}'. Allowed: {', '.join(VALID_RUNTIMES)}.")
            sys.exit(1)
        config["runtime"] = runtime.lower()

    if worktrees is not None:
        config["worktrees"] = bool(worktrees)

    if max_ping_pong is not None:
        if max_ping_pong < 1:
            print("Error: max_ping_pong must be >= 1.")
            sys.exit(1)
        config["max_ping_pong"] = int(max_ping_pong)

    if communication_mode is not None:
        if communication_mode.lower() not in VALID_COMMS:
            print(f"Error: Invalid communication mode '{communication_mode}'. Allowed: {', '.join(VALID_COMMS)}.")
            sys.exit(1)
        config["communication_mode"] = communication_mode.lower()

    if pr_demo_mode is not None:
        if pr_demo_mode.lower() not in VALID_PR_DEMO_MODES:
            print(f"Error: Invalid pr_demo_mode '{pr_demo_mode}'. Allowed: {', '.join(VALID_PR_DEMO_MODES)}.")
            sys.exit(1)
        config["pr_demo_mode"] = pr_demo_mode.lower()
    save_config(config)
    print(f"[CONFIG] Initialized configuration at {CONFIG_PATH}")
    print(json.dumps(config, indent=2))

def print_usage():
    print("Usage:")
    print("  bmc-config show")
    print("  bmc-config get <key>")
    print("  bmc-config set <key> <value>")
    print("  bmc-config init [--runtime docker|local] [--worktrees] [--no-worktrees] [--max-ping-pong N] [--communication ste100|caveman] [--pr-demo-mode reference|embed|minimal]")

def main():
    if len(sys.argv) < 2:
        print_usage()
        sys.exit(1)

    action = sys.argv[1].lower()

    if action == "show":
        cmd_show()
    elif action == "get":
        if len(sys.argv) < 3:
            print("Error: Missing key name.")
            print("Usage: bmc-config get <key>")
            sys.exit(1)
        cmd_get(sys.argv[2])
    elif action == "set":
        if len(sys.argv) < 4:
            print("Error: Missing key or value.")
            print("Usage: bmc-config set <key> <value>")
            sys.exit(1)
        cmd_set(sys.argv[2], sys.argv[3])
    elif action == "init":
        parser = argparse.ArgumentParser(prog="bmc-config init")
        parser.add_argument("--runtime", choices=VALID_RUNTIMES)
        parser.add_argument("--worktrees", dest="worktrees", action="store_true", default=None)
        parser.add_argument("--no-worktrees", dest="worktrees", action="store_false")
        parser.add_argument("--max-ping-pong", type=int)
        parser.add_argument("--communication", choices=VALID_COMMS)
        parser.add_argument("--pr-demo-mode", choices=VALID_PR_DEMO_MODES)
        args = parser.parse_args(sys.argv[2:])
        cmd_init(
            runtime=args.runtime,
            worktrees=args.worktrees,
            max_ping_pong=args.max_ping_pong,
            communication_mode=args.communication,
            pr_demo_mode=args.pr_demo_mode
        )
    elif action in ["-h", "--help", "help"]:
        print_usage()
    else:
        print(f"Error: Unknown action '{action}'.")
        print_usage()
        sys.exit(1)

if __name__ == "__main__":
    main()
